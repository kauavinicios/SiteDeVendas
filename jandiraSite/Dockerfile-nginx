FROM nginx:stable-alpine

RUN addgroup -S www-data 2>/dev/null; \
    adduser -D -H -u 1000 -s /bin/bash -G www-data www-data

RUN mkdir -p /var/www /etc/nginx/sites-available /etc/nginx/conf.d \
    && chown -R www-data:www-data /var/www

RUN apk add --no-cache logrotate openssl bash certbot certbot-nginx

RUN rm -f /etc/nginx/conf.d/default.conf

WORKDIR /etc/nginx

CMD ["nginx", "-g", "daemon off;"]