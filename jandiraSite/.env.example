APP_NAME="Butique da Jandira"
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jandiraDB
DB_USERNAME=postgres
# Deixe vazio: o scripts/setup.sh gera uma senha aleatória ao criar o container
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=*
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Número que recebe os pedidos do carrinho (somente dígitos, com DDI+DDD. Ex.: 5511999999999)
WHATSAPP_NUMBER=

# InfinitePay Checkout Integrado
# Use "mock" para simular o checkout localmente sem transações reais, ou "live" para a API oficial.
INFINITEPAY_DRIVER=mock
INFINITEPAY_BASE_URL=https://api.checkout.infinitepay.io
# InfiniteTag sem "$" (suficiente para operar no modo "live" mesmo sem X-Api-Key)
INFINITEPAY_HANDLE=
# Opcional por enquanto; quando gerada no painel InfinitePay, ativa o header X-Api-Key e "options" avançados
INFINITEPAY_API_KEY=
# Token secreto incluído na URL do webhook (/webhooks/infinitepay/{secret})
INFINITEPAY_WEBHOOK_SECRET=
INFINITEPAY_TIMEOUT=15
INFINITEPAY_SINGLE_PAYMENT=true
INFINITEPAY_REQUIRE_DELIVERY_ADDRESS=false
