# ==============================================================================
# Template de Ambiente de PRODUÇÃO — Butique da Jandira
# Stack: Caddy + PHP-FPM + Queue Worker + Scheduler + PostgreSQL 18
# Copie para .env no servidor e preencha os valores reais (NUNCA versione .env).
# ==============================================================================

APP_NAME="Butique da Jandira"
APP_ENV=production
# Gere uma única vez com: php artisan key:generate --show
# ATENÇÃO: Nunca altere APP_KEY após dados criptografados existirem no banco!
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://seudominio.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# Caddy / Servidor Web
# ------------------------------------------------------------------------------
# Domínio público para HTTPS automático (Let's Encrypt / ZeroSSL) pelo Caddy.
# Use ":80" se estiver atrás de Cloudflare Tunnel / proxy reverso externo.
SITE_ADDRESS=seudominio.com.br
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# Banco de Dados (container PostgreSQL 18)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=jandiraDB
DB_USERNAME=jandira
# Obrigatória: gere com `openssl rand -hex 24`
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Sessão e Proxy Reverso
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Confia nos cabeçalhos X-Forwarded-* do Caddy na rede interna Docker.
# Opcionalmente restrinja à sub-rede Docker (ex.: 172.16.0.0/12).
TRUSTED_PROXIES=*

# ------------------------------------------------------------------------------
# Filas, Cache e Armazenamento
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=jandira_prod_

# ------------------------------------------------------------------------------
# E-mail (SMTP transacional e campanhas)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contato@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Frontend & Loja
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
# Número que recebe os pedidos do carrinho (somente dígitos com DDI+DDD. Ex.: 5567999999999)
WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# InfinitePay Checkout Integrado (Produção)
# ------------------------------------------------------------------------------
INFINITEPAY_DRIVER=live
INFINITEPAY_BASE_URL=https://api.checkout.infinitepay.io
# InfiniteTag sem "$"
INFINITEPAY_HANDLE=
INFINITEPAY_API_KEY=
# Obrigatório em produção (>= 24 caracteres): gere com `openssl rand -hex 24`
INFINITEPAY_WEBHOOK_SECRET=
INFINITEPAY_TIMEOUT=15
INFINITEPAY_SINGLE_PAYMENT=true
INFINITEPAY_REQUIRE_DELIVERY_ADDRESS=false
